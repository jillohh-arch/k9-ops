# Firebase Web config template — STAGING (project: k9-ops-staging)
#
# Copy this file to `.env.local` for local staging development:
#   cp .env.staging.example .env.local
# then fill the placeholder values from the Firebase console for the
# `k9-ops-staging` project (Project settings -> General -> Your apps -> Web).
#
# DO NOT commit `.env.local` or any real values. Only this template is tracked.
# NEVER point local development at the production project (`canil-gcm`): the
# fail-closed guard in `src/lib/firebase/config.ts` throws if APP_ENV=staging
# and the resolved project is anything other than `k9-ops-staging`.

# Environment selector. REQUIRED, no default. Must be "staging" or "production".
NEXT_PUBLIC_APP_ENV=staging

# Target project identity. For staging this MUST remain k9-ops-staging;
# the guard rejects any other value while APP_ENV=staging.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=k9-ops-staging

# Remaining public Firebase config — REQUIRED, non-blank. Fill from the
# k9-ops-staging Web app config. These are placeholders, not real values.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_STAGING_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=k9-ops-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=k9-ops-staging.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_STAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_STAGING_APP_ID

# Optional. Leave blank/unset if the staging project has no Analytics stream.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional. Defaults to southamerica-east1 in code if unset.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=southamerica-east1
